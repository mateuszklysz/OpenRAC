#
# The translations built into the port, behind common/i18n_files.h: every port/lang/*.po (the
# port's own words, common/i18n.h) and port/lang/game/*.po (the game's texts, by key:
# game/common/game_text.h, named "game/<code>.po") becomes bytes in a generated source of TARGET.
# Translations are part of the program, so a game never depends on files beside it; adding or
# editing a .po configures again.

include_guard(GLOBAL)

function(openrac_embed_translations target)
  file(GLOB files CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/lang/*.po"
                                    "${PROJECT_SOURCE_DIR}/lang/game/*.po")
  list(SORT files)
  # A file's words changing configures again too (the glob alone notices files added or removed).
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${files})
  set(arrays "")
  set(entries "")
  set(index 0)
  foreach(file IN LISTS files)
    file(RELATIVE_PATH name "${PROJECT_SOURCE_DIR}/lang" "${file}")
    file(READ "${file}" hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND arrays "const unsigned char k${index}[] = {${bytes}0};\n")
    string(APPEND entries "        {\"${name}\", text(k${index}, sizeof k${index} - 1)},\n")
    math(EXPR index "${index} + 1")
  endforeach()
  set(dir "${CMAKE_CURRENT_BINARY_DIR}/generated")
  file(CONFIGURE OUTPUT "${dir}/i18n_files.cpp"
    CONTENT "// Generated by port/cmake/Lang.cmake from port/lang; do not edit.\n#include \"common/i18n_files.h\"\n\n#include <cstddef>\n\nnamespace openrac::i18n::files {\n\nnamespace {\n${arrays}\nstd::string_view text(const unsigned char* bytes, std::size_t size) {\n    return {reinterpret_cast<const char*>(bytes), size};\n}\n\n}  // namespace\n\nstd::span<const File> all() {\n    static const File list[] = {\n${entries}        {nullptr, {}},\n    };\n    return {list, std::size(list) - 1};\n}\n\n}  // namespace openrac::i18n::files\n"
    @ONLY)
  target_sources(${target} PRIVATE "${dir}/i18n_files.cpp")
endfunction()
