#: all_text
msgid "21086/41ec3363"
msgstr ""
"TAUNTER! DENERWUJ WROGÓW I WAB ICH W PUŁAPKI I ZASADZKI TYM NIEZNOŚNYM "
"HAŁASOWNIKIEM!"

#: all_text
msgid "21087/fb31c40d"
msgstr "BLASTER! WYCELUJ MNIEJ WIĘCEJ W ZŁYCH I KOŚ ICH!"

#: all_text
msgid "21088/c77c6410"
msgstr ""
"PYROCITOR! TA STRASZNA BROŃ NAJLEPIEJ SPRAWDZA SIĘ Z BLISKA. ŚWIETNA NA "
"UPIERDLIWYCH MAŁYCH WROGÓW."

#: all_text
msgid "21089/31524c2d"
msgstr ""
"MINE GLOVE! BĄDŹ PODSTĘPNY I ZASTAWIAJ NA WROGÓW bWbYbBbUbCbHbObWbEb "
"PUŁAPKI!"

#: all_text
msgid "21090/83a8a8a3"
msgstr "WALLOPER! WAL LUDZI MOCNO."

#: all_text
msgid "21091/836ee1e7"
msgstr "TESLA CLAW! RAŻ ZŁYCH PIORUNAMI!"

#: all_text
msgid "21092/a229770f"
msgstr ""
"GLOVE OF DOOM! WYPUŚĆ HORDĘ WYBUCHOWYCH bKbUbMbPbLbIb, KTÓRZY DOPADNĄ "
"TWOICH WROGÓW!"

#: all_text
msgid "21093/a78e916d"
msgstr ""
"R.Y.N.O! NISZCZY WSZYSTKO, CO WIDZISZ, I PEWNIE SPORO TEGO, CZEGO NIE "
"WIDZISZ."

